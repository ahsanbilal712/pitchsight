{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whyline.dev/schemas/cue.schema.json",
  "title": "Cue",
  "description": "One timed, machine-readable on-screen instruction. The Cue Sheet (a stream of these) is the product boundary: everything above it renders, everything below it produces. English only. No audio.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cue_id", "match_id", "t_in_ms", "t_out_ms", "clock", "period", "layer", "priority", "kind", "targets", "text", "explain", "verified", "producer_status", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "cue_id": { "type": "string", "pattern": "^c_[0-9]{6}$" },
    "match_id": { "type": "string", "pattern": "^m_[0-9]+$" },
    "moment_id": { "type": ["string", "null"], "pattern": "^mo_[0-9]{5}$" },
    "t_in_ms": { "type": "integer", "minimum": 0, "description": "Match time at which the cue appears." },
    "t_out_ms": { "type": "integer", "minimum": 0, "description": "Match time at which the cue is removed. Must exceed t_in_ms." },
    "clock": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
    "period": { "type": "integer", "enum": [1, 2] },
    "layer": { "type": "string", "enum": ["lower_third", "pitch_overlay", "heatmap", "ticker", "player_tag", "radar", "recap_card", "referee_line", "threat_front", "options_card"] },
    "priority": { "type": "number", "minimum": 0, "maximum": 1 },
    "leverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Absolute win-probability swing of the underlying moment, if any." },
    "kind": { "type": "string", "enum": ["sliding_doors", "state_change", "big_chance", "goal", "tempo_shift", "player_tag", "milestone", "pressing_trap", "fourth_official", "oracle", "dugout", "decision_index", "recap", "fast_line"] },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes"],
      "properties": {
        "modes": { "type": "array", "items": { "type": "string", "enum": ["analyst", "casual", "player_cam", "studio"] }, "minItems": 1 },
        "clubs": { "type": "array", "items": { "type": "string" }, "default": ["any"] },
        "players": { "type": "array", "items": { "type": "string", "pattern": "^p_[0-9]{3}$" }, "default": [] }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "body"],
      "properties": {
        "headline": { "type": "string", "maxLength": 60 },
        "body": { "type": "string", "maxLength": 280 }
      }
    },
    "graphics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pitch_control_snapshot": { "type": ["string", "null"], "pattern": "^pc_[0-9]{6}$" },
        "ghost_trail": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } },
        "players_highlight": { "type": "array", "items": { "type": "string", "pattern": "^p_[0-9]{3}$" } },
        "lines": { "type": "array", "description": "Fourth Official: drawn lines as [[x1,y1],[x2,y2]] in metres.", "items": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "minItems": 2, "maxItems": 2 } },
        "bar": { "type": ["object", "null"], "additionalProperties": false, "properties": { "label": { "type": "string" }, "from": { "type": "number" }, "to": { "type": "number" } } }
      }
    },
    "explain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["why", "claims"],
      "properties": {
        "why": { "type": "string", "maxLength": 400 },
        "claims": { "type": "array", "items": { "$ref": "explanation.schema.json#/$defs/claim" } },
        "counterfactual_id": { "type": ["string", "null"], "pattern": "^cf_[0-9]{6}$" },
        "explanation_id": { "type": ["string", "null"], "pattern": "^ex_[0-9]{6}$" }
      }
    },
    "verified": { "type": "boolean", "description": "True only if every claim passed the deterministic Fact Checker." },
    "producer_status": { "type": "string", "enum": ["auto", "approved", "vetoed", "held"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "agent_path", "trace_id"],
      "properties": {
        "mode": { "type": "string", "enum": ["replay", "live", "degraded"] },
        "agent_path": { "type": "array", "items": { "type": "string" } },
        "trace_id": { "type": "string" },
        "resumed_from_checkpoint": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] },
        "cache_key": { "type": ["string", "null"] }
      }
    }
  },
  "examples": [
    {
      "schema_version": "1.0.0",
      "cue_id": "c_000912",
      "match_id": "m_4242",
      "moment_id": "mo_00077",
      "t_in_ms": 1878200,
      "t_out_ms": 1886200,
      "clock": "31:18",
      "period": 1,
      "layer": "lower_third",
      "priority": 0.82,
      "leverage": 0.09,
      "kind": "sliding_doors",
      "targets": { "modes": ["analyst", "casual"], "clubs": ["any"], "players": ["p_017", "p_031"] },
      "text": { "headline": "Okafor shoots. Reyes was free.", "body": "Shot from a tight angle: 0.06 xG. Reyes unmarked at the far post: 0.31 xG. In 200 replays Verdant score within 8 seconds 11% of the time after the shot and 27% after the pass. Win chance 42% to 51%." },
      "graphics": { "pitch_control_snapshot": "pc_000412", "ghost_trail": [[87.5, 29.5], [98.9, 39.8], [105.0, 33.0]], "players_highlight": ["p_017", "p_031"], "lines": [], "bar": { "label": "Verdant win chance", "from": 0.42, "to": 0.51 } },
      "explain": {
        "why": "A 2v1 overload on the right had pulled the centre-back out; Reyes was unmarked at the far post with the keeper committed to the near post.",
        "claims": [
          { "text": "0.06 xG", "kind": "number", "value": 0.06, "unit": "xg", "evidence_ids": ["e_8812"], "verified": true },
          { "text": "0.31 xG", "kind": "number", "value": 0.31, "unit": "xg", "evidence_ids": ["cf_000077"], "verified": true },
          { "text": "Reyes", "kind": "player", "value": "p_031", "unit": null, "evidence_ids": ["e_8812"], "verified": true },
          { "text": "42% to 51%", "kind": "number", "value": 0.09, "unit": "win_prob_delta", "evidence_ids": ["cf_000077"], "verified": true }
        ],
        "counterfactual_id": "cf_000077",
        "explanation_id": "ex_000077"
      },
      "verified": true,
      "producer_status": "auto",
      "provenance": { "mode": "replay", "agent_path": ["scout", "proposer", "tactician", "narrator", "factchecker", "director"], "trace_id": "0af7c2d1e9b84b3f", "resumed_from_checkpoint": null, "model": "claude-opus-5-5", "prompt_version": "tactician@3", "cache_key": "m_4242/mo_00077/tactician@3/claude-opus-5-5/s4242" }
    }
  ]
}
