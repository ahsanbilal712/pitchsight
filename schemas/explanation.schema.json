{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whyline.dev/schemas/explanation.schema.json",
  "title": "Explanation",
  "description": "The Tactician's structured output for one moment. Every claim is bound to evidence IDs (events, counterfactuals, facts or pitch-control snapshots). The Fact Checker verifies claims; the Narrator may only use verified claims.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "explanation_id", "match_id", "moment_id", "why", "claims", "confidence", "model", "prompt_version"],
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "kind", "value", "unit", "evidence_ids", "verified"],
      "properties": {
        "text": { "type": "string", "maxLength": 80, "description": "The exact substring that will appear on screen." },
        "kind": { "type": "string", "enum": ["number", "player", "team", "minute", "tactical"] },
        "value": { "type": ["number", "string", "null"] },
        "unit": { "type": ["string", "null"], "enum": ["xg", "xt", "win_prob", "win_prob_delta", "p_goal", "metres", "kmh", "seconds", "count", "percent", "minute", null] },
        "evidence_ids": { "type": "array", "items": { "type": "string", "pattern": "^(e_[0-9]{4,}|cf_[0-9]{6}|f_[0-9]{6}|pc_[0-9]{6})$" }, "minItems": 1 },
        "verified": { "type": "boolean" },
        "reject_reason": { "type": ["string", "null"] }
      }
    }
  },
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "explanation_id": { "type": "string", "pattern": "^ex_[0-9]{6}$" },
    "match_id": { "type": "string" },
    "moment_id": { "type": "string", "pattern": "^mo_[0-9]{5}$" },
    "why": { "type": "string", "maxLength": 400, "description": "Causal story in one to three sentences. Numbers inside it must also appear as claims." },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" }, "minItems": 1, "maxItems": 8 },
    "counterfactual_id": { "type": ["string", "null"], "pattern": "^cf_[0-9]{6}$" },
    "alternatives_considered": { "type": "array", "items": { "type": "string" }, "description": "Proposer alternatives, in the policy's probability order." },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "model": { "type": "string" },
    "prompt_version": { "type": "string", "pattern": "^[a-z_]+@[0-9]+$" },
    "tool_trace_id": { "type": ["string", "null"] },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3, "default": 1, "description": "Rewrite-loop attempt number; the Fact Checker returns to the Narrator at most twice." }
  },
  "examples": [
    {
      "schema_version": "1.0.0",
      "explanation_id": "ex_000077",
      "match_id": "m_4242",
      "moment_id": "mo_00077",
      "why": "A 2v1 overload on the right pulled the centre-back out. Reyes was unmarked at the far post with the keeper committed to the near post, so the square pass was worth far more than the shot.",
      "claims": [
        { "text": "0.06 xG", "kind": "number", "value": 0.06, "unit": "xg", "evidence_ids": ["e_8812"], "verified": true, "reject_reason": null },
        { "text": "0.31 xG", "kind": "number", "value": 0.31, "unit": "xg", "evidence_ids": ["cf_000077"], "verified": true, "reject_reason": null },
        { "text": "11%", "kind": "number", "value": 0.11, "unit": "p_goal", "evidence_ids": ["cf_000077"], "verified": true, "reject_reason": null },
        { "text": "27%", "kind": "number", "value": 0.27, "unit": "p_goal", "evidence_ids": ["cf_000077"], "verified": true, "reject_reason": null },
        { "text": "2v1 overload on the right", "kind": "tactical", "value": "overload_right", "unit": null, "evidence_ids": ["pc_000412"], "verified": true, "reject_reason": null }
      ],
      "counterfactual_id": "cf_000077",
      "alternatives_considered": ["square pass to Reyes", "hold and wait for the overlap", "cut inside onto the left foot"],
      "confidence": 0.78,
      "model": "claude-opus-5-5",
      "prompt_version": "tactician@3",
      "tool_trace_id": "0af7c2d1e9b84b3f",
      "attempt": 1
    }
  ]
}
