  "labels": "on screen: name, else shirt, else nothing; both only from track B's names_live_0.json within its window; label/track_id are internal ids, never shown",
  "match_id": "m_9003",
  "period": 2,
  "rules": {
   "ball": "tiled full-resolution detection plus the full-frame one, minus the penalty and centre spots; conf >= 0.5 stands alone, weaker only within 35 m/s of the nearest confident one (1 s) or at conf >= 0.4 with none near",
   "dead_ball": "null once the ball is past a line, and from a goal's reviewed strike (a disallowed goal: its tagged second) to the end of the shot",
   "goal_line": "positions on or behind the goal line are valued 0.5 m out (the model has no shots there)",
   "holder": "tracked player nearest the ball within 2.5 m, else 'ball loose'",
   "in_flight": "no holder while the ball's ground speed exceeds 12 m/s over ~0.2 s (a pass or a ball in the air, whose ground position a single camera cannot place), or where it cannot be measured (fewer than two ball detections within 0.12 s)",
   "keepers": "by position, one per goal, plus track B's hand corrections (moments/overrides.json, same camera shot, which also remove referees): opponents for control, never pass options",
   "onside": "offside_risk = within 0.5 m of the line (second-last defender, ball or halfway); never best",
   "own_half": "no xG while the holder or the receiver is in his own half (the model has no shots there)",
   "possession": "the holder's team must hold for 3 samples (0.3 s) before possession switches; a holder of the other team before then is 'possession unsettled'",
   "possession_carrier": "the same player at the ball before and after a gap of <= 1.5 s with the ball unseen and no other player within 1.5 m of him keeps it through the gap (carrier_source 'possession'); never across a ball seen elsewhere",
   "trusted": "false where the camera fit is not trusted at the frame, or no ball and no possession carrier"
  },
