# Copy to .env (git-ignored). Variable names only; never commit values.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=                     # Gemini Developer API key; leave empty to use Vertex AI below
GOOGLE_GENAI_USE_VERTEXAI=          # true: Gemini via Vertex AI with gcloud application-default credentials
GOOGLE_CLOUD_PROJECT=               # Vertex AI project id (only with GOOGLE_GENAI_USE_VERTEXAI=true)
GOOGLE_CLOUD_LOCATION=global
WHYLINE_MODE=replay                 # replay | live | degraded
WHYLINE_MATCH_SEED=4242
WHYLINE_CACHE_DIR=data/matches/4242/cache
WHYLINE_CHECKPOINT_DIR=.checkpoints  # FileCheckpointStorage path (local); Cosmos in Azure
WHYLINE_SPEND_LEDGER=data/spend/ledger.jsonl
WHYLINE_PER_MATCH_CAP_USD=2.50
WHYLINE_PER_DAY_CAP_USD=10.00
WHYLINE_API_PORT=8000
WHYLINE_MCP_PORT=8080
WHYLINE_DEVICE=mps                  # mps | cpu | cuda
# Azure (only when WHYLINE_CLOUD=1)
WHYLINE_CLOUD=0
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE_NAME=whyline
AZURE_COSMOS_CONTAINER_NAME=checkpoints
AZURE_WEBPUBSUB_CONNECTION_STRING=
APPLICATIONINSIGHTS_CONNECTION_STRING=
FOUNDRY_PROJECT_ENDPOINT=
